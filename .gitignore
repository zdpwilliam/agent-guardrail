.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# 运行时数据（仅忽略 SQLite 库与审计链，保留 data/ 下的种子/schema 文件）
data/*.db
data/*.db-journal
data/*.sqlite3
*.db
*.db-journal
*.sqlite3
