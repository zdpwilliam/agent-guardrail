.env.*.local

# 编辑器
.idea/
.vscode/

# Superpowers 执行台账（本机进度记录）
.superpowers/

# WorkBuddy 沙箱下系统 TMPDIR 不可写（tmp_path fixture 会 PermissionError），
# 把 pytest 临时目录固定在项目内。
.pytest_tmp/
.workbuddy/
