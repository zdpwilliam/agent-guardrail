# 网关
SHOP_BASE_URL=http://127.0.0.1:8100
GATEWAY_DB_PATH=data/gateway.db
GUARDRAIL_ENV=development
GUARDRAIL_DB_BUSY_TIMEOUT_MS=5000
GUARDRAIL_RATE_LIMIT_REQUESTS=120
GUARDRAIL_RATE_LIMIT_WINDOW_SECONDS=60
GUARDRAIL_MAX_REQUEST_BYTES=1048576
GUARDRAIL_RETENTION_DAYS=365
# 生产环境必须完整配置以下四项，否则网关拒绝启动。
# GUARDRAIL_CONSOLE_KEY=replace-with-a-long-random-key
# GUARDRAIL_CONSOLE_APPROVER_ID=security_lead
# GUARDRAIL_AGENT_API_KEYS={"agent-key":"ops_agent"}
# GUARDRAIL_APPROVER_API_KEYS={"approver-key":"security_lead"}
# 商城（仅商城进程读取 SHOP_DB_PATH，网关不读取）
SHOP_DB_PATH=data/shop.db
